{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "fluid": true,
  "installCommand": "npm ci --prefix app",
  "buildCommand": "node scripts/prepare-vercel-static.mjs",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?__kalpi_path=/api/:path*" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{app/data/**,app/server/**}",
      "maxDuration": 10
    }
  },
  "crons": [
    { "path": "/api/health", "schedule": "0 8 * * *" }
  ]
}
