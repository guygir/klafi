{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix app",
  "buildCommand": "node scripts/prepare-vercel-static.mjs",
  "functions": {
    "api/[[...path]].js": {
      "includeFiles": "{app/data/**,app/server/**}",
      "maxDuration": 10,
      "memory": 1024
    }
  }
}
