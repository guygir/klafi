# Local / private-repo defaults. No cloud API keys exist yet.
# Other machines: start Postgres, then `cd app && npm run poc`.

NODE_ENV=development
HOST=0.0.0.0
PORT=4173

# Homebrew or docker-compose Postgres on this machine.
DATABASE_URL=postgresql://kalpi:change-me@127.0.0.1:5432/kalpi
DATABASE_SSL=0
DATABASE_POOL_SIZE=10

# Quiz + Israel-civil-day extra pack stay off until we turn them back on.
QUIZ_ENABLED=0

# Local Studio / debug only. Never set in production.
KALPI_DEBUG=1
