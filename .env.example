# Copy to `.env`. Do not commit `.env`.
# Production values live only in the Vercel project env.

NODE_ENV=production
HOST=0.0.0.0
PORT=4173

# Docker Compose service hostname is `postgres`. Host-machine PoC uses 127.0.0.1.
DATABASE_URL=postgresql://kalpi:change-me@127.0.0.1:5432/kalpi
DATABASE_SSL=0
DATABASE_POOL_SIZE=10
QUIZ_ENABLED=0
KALPI_DEBUG=0
